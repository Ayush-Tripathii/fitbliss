# ==============================================================================
# FitBliss wp-includes Directory Security Protection
# Prohibits direct access to internal include scripts
# ==============================================================================

<FilesMatch "\.(php|inc)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
