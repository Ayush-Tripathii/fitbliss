# ==============================================================================
# FitBliss Uploads Directory Security Lockdown
# Prohibits execution of ANY server-side scripts in the uploads directory
# ==============================================================================

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|inc|cgi|pl|py|sh|exe|asp|aspx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI
